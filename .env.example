# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Providers (see docs/ARCHITECTURE.md §4) ──────────────
BUSINESS_PROVIDER=osm
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Overpass etiquette: include contact info in the User-Agent
OVERPASS_USER_AGENT=

# ── Persistence (Phase 5, until Phase 6 auth lands) ──────
# Owner of scans created via the API. Seed with:
#   node --env-file=.env.local scripts/seed-dev-user.mjs
DEV_USER_ID=
# Optional overrides for the seed script (defaults: dev@localhost.local / dev-password-1234)
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
